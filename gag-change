-- tach chuoi tim item
local function cleanItemName(rawName)
    return rawName:match("^(.-)%s*%[") or rawName
end

local function postSingleItem(itemName)
    local playerName = player.Name
    local encodedItem = string.gsub(itemName, " ", "+")
    local encodedPlayer = string.gsub(playerName, " ", "+")
    local encodedData = "item=" .. encodedItem .. "&player=" .. encodedPlayer .. "&deviceid=" .. deviceID

    local response = request({
        Url = "http://m5.d4shopsever.com:4444",
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/x-www-form-urlencoded",
        },
        Body = encodedData
    })
end

